# LLM provider: groq (default, free) | gemini (free) | openai (paid)
LLM_PROVIDER=groq

# Groq — free development key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WEB_MODEL=groq/compound

# Google Gemini — another free option: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Optional paid fallbacks (not required for development)
# OPENAI_API_KEY=your_openai_api_key_here
# PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Grace Hopper model id (defaults to the provider model above)
GRACE_HOPPER_MODEL_ID=llama-3.3-70b-versatile
